{
  "_comment": "VEX 报名统计表专用规则：无手机号列，必填只保留姓名与学号；不启手机号/日期/白名单规则",
  "input": {
    "sheet": null,
    "header_scan_rows": 12
  },
  "columns": {
    "required": ["姓名", "学号"],
    "dates": [],
    "numeric_ranges": {},
    "whitelist": {},
    "phone_pattern": "^1[3-9]\\d{9}$",
    "student_id_pattern": "^[A-Za-z]?\\d{7,11}$"
  },
  "rules": {
    "R01_duplicate_row": true,
    "R02_duplicate_student_id": true,
    "R03_duplicate_phone": false,
    "R04_phone_format": false,
    "R05_student_id_format": true,
    "R06_required_missing": true,
    "R07_name_normalize": true,
    "R08_date_normalize": false,
    "R09_column_name_normalize": true,
    "R10_numeric_range": false,
    "R11_whitelist": false,
    "R12_structure_merge": true
  }
}
